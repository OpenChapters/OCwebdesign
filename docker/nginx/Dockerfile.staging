# ---------------------------------------------------------------------------
# OpenChapters — staging nginx image (multi-stage)
#
# Identical to the production image except it ships nginx.staging.conf
# (plain HTTP, no Let's Encrypt cert paths).
#
# Build context: repo root (OCwebdesign/)
# ---------------------------------------------------------------------------

FROM node:20-alpine AS frontend

ARG VITE_SENTRY_DSN=""
ARG VITE_SENTRY_ENVIRONMENT="staging"
ARG VITE_SENTRY_RELEASE=""
ENV VITE_SENTRY_DSN=${VITE_SENTRY_DSN}
ENV VITE_SENTRY_ENVIRONMENT=${VITE_SENTRY_ENVIRONMENT}
ENV VITE_SENTRY_RELEASE=${VITE_SENTRY_RELEASE}

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend/ .
RUN npm run build

FROM nginx:alpine

RUN rm /etc/nginx/conf.d/default.conf

COPY docker/nginx/nginx.staging.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend /build/dist /usr/share/nginx/html

EXPOSE 80
