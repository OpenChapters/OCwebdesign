# OpenChapters — staging environment variables.
# Copy to .env.staging and fill in values before bringing the stack up.
# Picks up DJANGO_SETTINGS_MODULE=ocweb.settings.staging via the compose file.

# ── Django ────────────────────────────────────────────────────────────────────
# Different SECRET_KEY than prod, so leaking a staging session token
# would not affect production.
SECRET_KEY=generate-a-separate-random-string-for-staging
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# ── Database (isolated from prod via the postgres_data_staging volume) ───────
DATABASE_URL=postgres://ocweb:ocweb-staging-pass@db:5432/ocweb
POSTGRES_DB=ocweb
POSTGRES_USER=ocweb
POSTGRES_PASSWORD=ocweb-staging-pass

# ── Celery / RabbitMQ ─────────────────────────────────────────────────────────
CELERY_BROKER_URL=amqp://ocweb:ocweb@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://
RABBITMQ_DEFAULT_USER=ocweb
RABBITMQ_DEFAULT_PASS=ocweb

# ── GitHub ────────────────────────────────────────────────────────────────────
# A read-only personal access token is sufficient — staging never pushes.
GITHUB_TOKEN=

# ── Email ─────────────────────────────────────────────────────────────────────
# settings/staging.py forces the console backend, so the SMTP fields
# here are ignored; left in to keep parity with the prod template.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
FROM_EMAIL=noreply-staging@openchapters.org

# Used by email links — points back at the staging URL so any
# "click to download" PDFs round-trip through the staging stack.
SITE_URL=http://localhost:8081

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# Wire a Sentry DSN here to ship staging errors with `environment=staging`
# so they're easy to filter out from prod incidents.
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
