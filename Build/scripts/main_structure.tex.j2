% !TEX TS-program = arara
(# Structure-preview template — emits only the book frontmatter, parts, #)
(# chapter titles, and TOC. No \include{} of real chapter sources, no   #)
(# biber, no makeindex, no examples. The arara directive block is much  #)
(# shorter than main.tex.j2 so a preview build completes in seconds.    #)
% arara: pdflatex: { shell: yes }
% arara: pdflatex: { shell: yes }
% arara: clean: { extensions: [aux, log, ptc, toc, out]}
%!TEX encoding = UTF-8 Unicode
%
% Generated by OpenChapters web build system — STRUCTURE PREVIEW.
% Build ID : (( build_id ))
% Build date: (( build_date ))
% Book title: (( book_title ))

\documentclass[11pt,fleqn,A4paper]{book}

\usepackage{OpenChapters}
\usepackage{arara}

\renewcommand{\gitMarkPref}{[OpenChapters Web Build — Structure Preview]}
\renewcommand{\chaptergraphicspath}{ImageFolder/}
\renewcommand{\graphicspath}{ImageFolder/}
\newcommand{\isHTML}{No}
\newcommand{\isEPUB}{No}

% preamble.ins defines \processauthors / \writeauthor which Postmatter
% calls; without it, the postmatter input would error with "Undefined
% control sequence" the first time \processauthors is reached.
\input{preamble.ins}

% Replace OpenChapters' image-heavy chapter heading with a plain
% text-only one for preview mode. The real package version pulls in a
% per-chapter \includegraphics whose filename is set by macros each
% chapter source file invokes — that machinery isn't available when
% the stub skips chapter \include{}s. Standard LaTeX book.cls heading
% form, copied here so we don't depend on \DocumentClass internals.
\makeatletter
\renewcommand{\@makechapterhead}[1]{%
  \vspace*{50\p@}%
  {\parindent \z@ \raggedright \normalfont
    \ifnum \c@secnumdepth >\m@ne
      \if@mainmatter
        \huge\sffamily\bfseries \@chapapp\space \thechapter\par\nobreak
        \vskip 20\p@
      \fi
    \fi
    \interlinepenalty\@M
    \Huge\sffamily\bfseries #1\par\nobreak
    \vskip 40\p@
  }}
\makeatother

% Stub bib so OpenChapters.sty's \addbibresource resolves without a real
% bibliography. mergemainbibfiles is not run in preview mode.
\IfFileExists{OpenChapters.bib}{\addbibresource{OpenChapters.bib}}{}

\begin{document}

\input{matter/Frontmatter}

% Open the authors file for writing after FrontMatter is complete.
\immediate\openout\authorfile=\jobname-authors.aux%

% ================================================================
% STRUCTURE PREVIEW — chapter titles only, no body content.
% ================================================================

(% for part in parts %)
% ----------------------------------------------------------------
\part{(( part.title ))}
% ----------------------------------------------------------------
(% for chapter in part.chapters %)
\chapter{(( chapter.title ))}
\noindent\textit{Body omitted — this is a structure preview.}\par
(% endfor %)

(% endfor %)
% ================================================================

\input{matter/Postmatter}

\end{document}
