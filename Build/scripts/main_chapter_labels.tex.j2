\documentclass[11pt,fleqn,A4paper]{book}

\usepackage{OpenChapters}
\usepackage{arara}

% showkeys prints every \label next to its anchor so prospective
% authors can see the existing label scheme (sections, equations,
% figures, tables) for cross-referencing in their own chapters.
\usepackage{showkeys}
% Long labels (e.g. BASCRY:fig:specific-thing) overflow the margin at
% the default size; \tiny keeps them on the page.
\renewcommand*\showkeyslabelformat[1]{\fbox{\normalfont\tiny\ttfamily#1}}

\renewcommand{\gitMarkPref}{[OpenChapters Web — labels]}

\renewcommand{\chaptergraphicspath}{ImageFolder/}
\renewcommand{\graphicspath}{ImageFolder/}
\newcommand{\isHTML}{No}
\newcommand{\isEPUB}{No}

\input{preamble.ins}

\addbibresource{chaptercitations.bib}

\begin{document}

\tableofcontents

\immediate\openout\authorfile=\jobname-authors.aux%

\include{(( include_path ))}

\printbibliography

\end{document}
